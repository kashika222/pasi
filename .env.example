# PASI environment template — copy to `.env` and fill values.
# Never commit real secrets.

# Provider: openai | gemini  (gemini free tier recommended for students)
PASI_LLM_PROVIDER=gemini

# Google AI Studio free key: https://aistudio.google.com/apikey
PASI_GEMINI_API_KEY=
PASI_GEMINI_MODEL=gemini-flash-latest

# OpenAI (optional; requires billing/credits)
PASI_OPENAI_API_KEY=
PASI_LLM_API_KEY=
PASI_OPENAI_MODEL=gpt-4o-mini
PASI_OPENAI_TEMPERATURE=0
PASI_OPENAI_MAX_INPUT_CHARS=60000

# Optional overrides
PASI_ENV=development
PASI_LOG_LEVEL=INFO
PASI_DATA_DIR=data
PASI_DB_PATH=db/pasi.sqlite
PASI_PROMPTS_DIR=prompts

# SEC EDGAR requires a descriptive User-Agent with a contact email
PASI_SEC_USER_AGENT=PASI Academic Research your.email@university.edu
PASI_HTTP_TIMEOUT_SECONDS=60
PASI_HTTP_MAX_RETRIES=3
PASI_HTTP_REQUEST_DELAY_SECONDS=0.25
